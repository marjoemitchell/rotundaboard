# Railway Postgres, via its public TCP proxy: the DATABASE_PUBLIC_URL
# variable on the Railway "db" service (not DATABASE_URL, which is only
# reachable inside Railway's private network).
DATABASE_URL=

# Names hearing speakers (Claude). Same key the Railway services use.
ANTHROPIC_API_KEY=
# Required when the API key isn't scoped to a single workspace (requests
# fail with "must include the anthropic-workspace-id header"). Use the same
# value as ANTHROPIC_WORKSPACE_ID on Railway.
ANTHROPIC_WORKSPACE_ID=

# Hugging Face read token. Before it works, accept the terms of
# https://huggingface.co/pyannote/speaker-diarization-community-1 while
# logged in as the token's owner.
HF_TOKEN=

# large-v3 is most accurate; large-v3-turbo is roughly 3-4x faster for a
# small accuracy cost. int8_float16 keeps large-v3 around 3 GB of VRAM; if a
# GTX 16xx card returns garbage text, try int8 or float32.
WHISPER_MODEL=large-v3
COMPUTE_TYPE=int8_float16
BATCH_SIZE=8

# Where model weights are cached on the host.
MODELS_DIR=/mnt/user/appdata/rotunda-whisperx

# Hearings transcribed per run, and the pause between runs (seconds).
DIARIZE_LIMIT=2
INTERVAL_SECONDS=1800
