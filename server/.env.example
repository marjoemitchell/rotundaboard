DATABASE_URL=postgres://rotunda:rotunda_dev_pw@127.0.0.1:5432/rotundaboard
LEGMT_API_BASE=https://bearbeta.legmt.gov

# Only needed for `npm run generate-summaries` (AI bill summaries).
ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=

# Used to build invite/reset-password links, and as the exact CORS origin for
# the session cookie (credentials:true forbids a wildcard origin).
APP_BASE_URL=http://localhost:5173

# Optional: without this, password-reset and invite emails are just logged
# to the console instead of sent (see server/src/auth/email.ts) — fine for
# local dev.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=notifications@rotundaboard.example
