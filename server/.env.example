DATABASE_URL=postgres://rotunda:rotunda_dev_pw@127.0.0.1:5432/rotundaboard
LEGMT_API_BASE=https://bearbeta.legmt.gov
# Committee "Meeting Materials" content comes from legmt.gov's own public
# WordPress site, a separate host/system from LEGMT_API_BASE.
LEGMT_WP_BASE=https://www.legmt.gov

# Needed for `npm run generate-summaries` (AI bill summaries), and by
# `npm run transcribe-hearings` to name hearing speakers.
ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=

# Used to build invite/reset-password links, and as the exact CORS origin for
# the session cookie (credentials:true forbids a wildcard origin).
APP_BASE_URL=http://localhost:5173

# Optional: without this, password-reset and invite emails are just logged
# to the console instead of sent (see server/src/auth/email.ts) — fine for
# local dev.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=notifications@rotundaboard.example

# `npm run transcribe-hearings`'s diarized (speaker-labeled) pass:
# TRANSCRIBE_BACKEND=whisperx uses our self-hosted GPU service at WHISPERX_URL
# (see deploy/unraid/); openai (the default) needs OPENAI_API_KEY. Without a
# usable backend the job still discovers recordings and ingests captions.
TRANSCRIBE_BACKEND=openai
WHISPERX_URL=
OPENAI_API_KEY=

# Gets an email when a scrape health check fails, and when a scrape job has
# no successful run in its expected time (see src/scrapeHealth.ts). Without
# it, the alerts are only written to the log.
MAINTAINER_EMAIL=

# The subscription plan of a new workspace: free, single_user, team, or
# organization. Leave it empty for the free plan. The e2e suite sets it to
# organization (playwright.config.ts).
NEW_WORKSPACE_PLAN=
